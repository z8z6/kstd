module std.annotation;

// Compiler-recognized annotations. Their declarations are ordinary Kelyra
// metadata; the compiler supplies the compile-time behavior.
// Additional load-time rule: @cfg requires at least one of os or arch.
pub annotation cfg(os: meta.string = "", arch: meta.string = "");

@target(class)
pub annotation interface();

// A class exposes its public instance fields plus explicitly marked fields.
// A field annotation also works without an annotation on its class.
@target(class, field)
pub annotation reflect();

@target(class)
pub annotation layout(kind: meta.symbol);

@target(function)
pub annotation extern(symbol: meta.string);

@target(function)
pub annotation callconv(abi: meta.string);

@target(function)
pub annotation main();

@target(function, method)
pub annotation inline(mode: meta.symbol = auto);

@target(function, method)
pub annotation deprecated(message: meta.string = "");

@target(annotation)
// The compiler also accepts multiple target kinds in one @target invocation.
pub annotation target(kind: meta.symbol);

@target(annotation)
pub annotation repeatable();

@target(annotation)
pub annotation retention(kind: meta.symbol);
