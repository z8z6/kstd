@cfg(os="windows", arch="x86_64") module std.signal.windows;

import std.win32.error;

@extern("GenerateConsoleCtrlEvent")
@callconv("system")
fn win_generate_console_ctrl_event(event: u32, process_group: u32) -> i32;

@extern("SetConsoleCtrlHandler")
@callconv("system")
fn win_set_console_ctrl_handler(handler: *u8, add: i32) -> i32;

// CTRL_C_EVENT=0, CTRL_BREAK_EVENT=1. The target must share a console.
// Returns zero or negative GetLastError; not equivalent to POSIX kill.
pub fn send_console_event(event: u32, process_group: u32) -> i64 {
  if event > 1 {
    return -87;
  }
  if win_generate_console_ctrl_event(event, process_group) == 0 {
    return -(std.win32.error.last_error() as i64);
  }
  return 0;
}

// NULL handler toggles the process-wide CTRL+C ignore state. This does not
// install a Kelyra callback; child processes can inherit this state.
pub fn ignore_control_c(ignore: bool) -> i64 {
  let add: i32 = 0;
  if ignore {
    add = 1;
  }
  if win_set_console_ctrl_handler(0 as *u8, add) == 0 {
    return -(std.win32.error.last_error() as i64);
  }
  return 0;
}
