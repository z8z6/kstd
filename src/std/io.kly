module std.io;
include c "io.h";

pub fn print(text: c.char*) -> c.int {
  return c.kstd_io_print(text);
}

pub fn println(text: c.char*) -> c.int {
  return c.kstd_io_println(text);
}

pub fn eprint(text: c.char*) -> c.int {
  return c.kstd_io_eprint(text);
}

pub fn eprintln(text: c.char*) -> c.int {
  return c.kstd_io_eprintln(text);
}

pub fn newline() -> c.int {
  return c.kstd_io_newline();
}

pub fn print_int(value: c.longlong) -> c.int {
  return c.kstd_io_print_int(value);
}

pub fn read_line() -> c.char* {
  return c.kstd_io_read_line();
}

pub fn read_int() -> c.longlong {
  return c.kstd_io_read_int();
}

pub fn flush() -> c.int {
  return c.kstd_io_flush();
}
