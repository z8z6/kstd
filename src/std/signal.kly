module std.signal;

@cfg(os="linux", arch="x86_64")
import std.signal.linux;
@cfg(os="windows", arch="x86_64")
import std.signal.windows;

@cfg(os="linux", arch="x86_64")
pub fn send_process(process_id: i64, number: i32) -> i64 {
  return std.signal.linux.send_process(process_id, number);
}

@cfg(os="linux", arch="x86_64")
pub fn send_thread(process_id: i64, thread_id: i64, number: i32) -> i64 {
  return std.signal.linux.send_thread(process_id, thread_id, number);
}

@cfg(os="windows", arch="x86_64")
pub fn send_console_event(event: u32, process_group: u32) -> i64 {
  return std.signal.windows.send_console_event(event, process_group);
}

@cfg(os="windows", arch="x86_64")
pub fn ignore_control_c(ignore: bool) -> i64 {
  return std.signal.windows.ignore_control_c(ignore);
}
