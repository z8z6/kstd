module std.thread;

@cfg(os="linux", arch="x86_64")
import std.thread.linux;
@cfg(os="windows", arch="x86_64")
import std.thread.windows;

@cfg(os="linux", arch="x86_64")
pub fn current_id() -> i64 {
  return std.thread.linux.current_id();
}

@cfg(os="windows", arch="x86_64")
pub fn current_id() -> i64 {
  return std.thread.windows.current_id() as i64;
}

@cfg(os="linux", arch="x86_64")
pub fn yield_now() -> i64 {
  return std.thread.linux.yield_now();
}

@cfg(os="windows", arch="x86_64")
pub fn yield_now() -> i64 {
  std.thread.windows.yield_now();
  return 0;
}

@cfg(os="linux", arch="x86_64")
pub fn wait_word(address: *u32, expected: u32) -> i64 {
  return std.thread.linux.wait_word(address, expected);
}

@cfg(os="windows", arch="x86_64")
pub fn wait_word(address: *u32, expected: u32) -> i64 {
  return std.thread.windows.wait_word(address, expected);
}

@cfg(os="linux", arch="x86_64")
pub fn wake_one(address: *u32) -> i64 {
  return std.thread.linux.wake_one(address);
}

@cfg(os="windows", arch="x86_64")
pub fn wake_one(address: *u32) -> i64 {
  std.thread.windows.wake_one(address);
  return 0;
}

@cfg(os="linux", arch="x86_64")
pub fn wake_all(address: *u32) -> i64 {
  return std.thread.linux.wake_all(address);
}

@cfg(os="windows", arch="x86_64")
pub fn wake_all(address: *u32) -> i64 {
  std.thread.windows.wake_all(address);
  return 0;
}
