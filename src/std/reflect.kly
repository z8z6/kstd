module std.reflect;

import std.result;

// Implemented by the compiler for each concrete T. The returned pointer names
// a read-only descriptor emitted by the object file that defines T.
fn __type_data<T>(probe: *T) -> *u8 {
  return 0 as*u8;
}

fn u32_at(data: *u8) -> u32 {
  let result: u32 = 0;
  let place: u32 = 1;
  let index: usize = 0;
  while index < 4 {
    let byte: u8 = *((data as usize + index) as*u8);
    result = result + (byte as u32) * place;
    if index < 3 {
      place = place * 256;
    }
    index = index + 1;
  }
  return result;
}

fn u64_at(data: *u8) -> u64 {
  let result: u64 = 0;
  let place: u64 = 1;
  let index: usize = 0;
  while index < 8 {
    let byte: u8 = *((data as usize + index) as*u8);
    result = result + (byte as u64) * place;
    if index < 7 {
      place = place * 256;
    }
    index = index + 1;
  }
  return result;
}

fn same_name(left: *c.char, right: *c.char) -> bool {
  let index: usize = 0;
  while true {
    let a: u8 = *((left as usize + index) as*u8);
    let b: u8 = *((right as usize + index) as*u8);
    if a != b {
      return false;
    }
    if a == 0 {
      return true;
    }
    index = index + 1;
  }
  return false;
}

pub class TypeInfo {
  pub id: u64;
  pub name: *c.char;
  data: *u8;
  pub fn field_count() -> u32 {
    if data as usize == 0 {
      return 0;
    }
    return u32_at((data as usize + 20) as*u8);
  }
  pub fn has_field(name: *c.char) -> bool {
    if data as usize == 0 {
      return false;
    }
    let cursor: usize = data as usize + 24 + u32_at((data as usize + 16) as*u8) as usize + 1;
    let index: u32 = 0;
    while index < field_count() {
      let name_size: usize = u32_at((cursor + 16) as*u8) as usize;
      let type_name_size: usize = u32_at((cursor + 20) as*u8) as usize;
      if same_name((cursor + 24) as*c.char, name) {
        return true;
      }
      cursor = cursor + 24 + name_size + 1 + type_name_size + 1;
      index = index + 1;
    }
    return false;
  }
  pub fn field(name: *c.char) -> std.result.Result<FieldInfo,
  i32> {
    if data as usize == 0 {
      return std.result.failure<std.reflect.FieldInfo, i32>(0);
    }
    let cursor: usize = data as usize + 24 + u32_at((data as usize + 16) as*u8) as usize + 1;
    let index: u32 = 0;
    while index < field_count() {
      let name_size: usize = u32_at((cursor + 16) as*u8) as usize;
      let type_name_size: usize = u32_at((cursor + 20) as*u8) as usize;
      if same_name((cursor + 24) as*c.char, name) {
        let result = FieldInfo();
        result.owner_id = id;
        result.owner_name = this.name;
        result.type_id = u64_at(cursor as*u8);
        result.offset = u64_at((cursor + 8) as*u8) as usize;
        result.name = (cursor + 24) as*c.char;
        result.type_name = (cursor + 25 + name_size) as*c.char;
        return std.result.success<std.reflect.FieldInfo, i32>(result);
      }
      cursor = cursor + 24 + name_size + 1 + type_name_size + 1;
      index = index + 1;
    }
    return std.result.failure<std.reflect.FieldInfo, i32>(0);
  }
}

pub class FieldInfo {
  owner_id: u64;
  owner_name: *c.char;
  type_id: u64;
  offset: usize;
  name: *c.char;
  type_name: *c.char;
  pub fn field_name() -> *c.char {
    return name;
  }
  pub fn type() -> TypeInfo {
    let result = TypeInfo();
    result.id = type_id;
    result.name = type_name;
    return result;
  }
}

pub class Value {
  type_id: u64;
  type_name: *c.char;
  address: *u8;
}

pub fn type_of<T>() -> TypeInfo {
  let data: *u8 = __type_data<T>(0 as*T);
  let result = TypeInfo();
  if data as usize == 0 || u32_at(data) != 1179798603 || u32_at((data as usize + 4) as*u8) != 1 {
    return result;
  }
  result.data = data;
  result.id = u64_at((data as usize + 8) as*u8);
  result.name = (data as usize + 24) as*c.char;
  return result;
}

pub fn value<T>(object: *T) -> Value {
  let result = Value();
  let info = type_of<T>();
  result.type_id = info.id;
  result.type_name = info.name;
  result.address = object as*u8;
  return result;
}

// err 1: wrong owner, 2: wrong field type, 3: null object.
pub fn read<T>(field: FieldInfo, object: Value) -> std.result.Result<T, i32> {
  if field.owner_id != object.type_id || field.owner_name as usize == 0 || object.type_name as usize == 0 || !same_name(field.owner_name, object.type_name) {
    return std.result.failure<T, i32>(1);
  }
  let field_type = type_of<T>();
  if field.type_id != field_type.id || field.type_name as usize == 0 || !same_name(field.type_name, field_type.name) {
    return std.result.failure<T, i32>(2);
  }
  if object.address as usize == 0 {
    return std.result.failure<T, i32>(3);
  }
  let pointer: *T = (object.address as usize + field.offset) as*T;
  return std.result.success<T, i32>(*pointer);
}

pub fn write<T>(field: FieldInfo, object: Value, incoming: T) -> std.result.Result<bool, i32> {
  if field.owner_id != object.type_id || field.owner_name as usize == 0 || object.type_name as usize == 0 || !same_name(field.owner_name, object.type_name) {
    return std.result.failure<bool, i32>(1);
  }
  let field_type = type_of<T>();
  if field.type_id != field_type.id || field.type_name as usize == 0 || !same_name(field.type_name, field_type.name) {
    return std.result.failure<bool, i32>(2);
  }
  if object.address as usize == 0 {
    return std.result.failure<bool, i32>(3);
  }
  let pointer: *T = (object.address as usize + field.offset) as*T;
  *pointer = incoming;
  return std.result.success<bool, i32>(true);
}
