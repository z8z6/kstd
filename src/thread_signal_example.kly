import std.signal;
import std.thread;

@cfg(os="linux", arch="x86_64")
@main
pub fn main() -> i32 {
  let id: i64 = std.thread.current_id();
  if id <= 0 || std.thread.yield_now() != 0 {
    return 1;
  }

  let word: u32 = 7;
  if std.thread.wait_word(&word, 8) != -11 {
    return 2;
  }
  if std.thread.wake_one(&word) != 0 || std.thread.wake_all(&word) != 0 {
    return 3;
  }

  // This smoke test runs on the initial thread, whose Linux TID equals PID.
  let pid: i64 = id;
  if std.signal.send_process(pid, 0) != 0 {
    return 4;
  }
  if std.signal.send_thread(pid, id, 0) != 0 {
    return 5;
  }
  return 0;
}

@cfg(os="windows", arch="x86_64")
@main
pub fn main() -> i32 {
  if std.thread.current_id() <= 0 || std.thread.yield_now() != 0 {
    return 1;
  }
  let word: u32 = 7;
  if std.thread.wait_word(&word, 8) != 0 {
    return 2;
  }
  if std.thread.wake_one(&word) != 0 || std.thread.wake_all(&word) != 0 {
    return 3;
  }
  if std.signal.send_console_event(2, 0) != -87 {
    return 4;
  }
  if std.signal.ignore_control_c(true) != 0 {
    return 5;
  }
  if std.signal.ignore_control_c(false) != 0 {
    return 6;
  }
  return 0;
}
